<UserControl x:Class="Sistema_Gestion.Views.PacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="970">

    <UserControl.Resources>

        <!-- Colores -->
        <SolidColorBrush x:Key="ColorPrimario" Color="#2F6FED"/>
        <SolidColorBrush x:Key="ColorPeligro" Color="#D93025"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#1B2A41"/>
        <SolidColorBrush x:Key="ColorTextoSuave" Color="#6B7A90"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#E1E8F0"/>

        <!-- Tarjeta (Border con esquinas redondeadas) -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Textos -->
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Controles de entrada (estilo implícito: afecta a todos los del tipo) -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C9D3E0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botones -->
        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource ColorPeligro}"/>
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="CabeceraGrid" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3FA"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CeldaTexto" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- cabecera: título y buscador -->
            <RowDefinition Height="Auto"/>
            <!-- tarjeta resumen -->
            <RowDefinition Height="*"/>
            <!-- tabla y formulario -->
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">

            <!-- Buscador (a la derecha) -->
            <Border DockPanel.Dock="Right" Style="{StaticResource Tarjeta}"
                    Width="320" Padding="12,6" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Text="Buscar:" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Style="{StaticResource Subtitulo}" Margin="0,0,8,0"/>
                    <TextBox Margin="0" BorderThickness="0"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Border>

            <StackPanel>
                <TextBlock Text="Panel de Control" Style="{StaticResource Titulo}"/>
                <TextBlock Text="Gestión de pacientes" Style="{StaticResource Subtitulo}"/>
            </StackPanel>
        </DockPanel>

        <!-- Tarjeta resumen -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}"
                HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding TotalPacientes}" FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource ColorPrimario}"/>
                <TextBlock Text="Pacientes registrados" Style="{StaticResource Subtitulo}"/>
            </StackPanel>
        </Border>

        <!-- Tabla + formulario -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Tabla de pacientes -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="+ Nuevo Paciente" Width="150"
                                Style="{StaticResource BotonPrimario}"
                                Command="{Binding NuevoCommand}"/>
                        <TextBlock Text="Pacientes" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- SelectedItem TwoWay: al elegir una fila, el ViewModel carga el formulario -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PacientesVista}"
                              SelectedItem="{Binding PacienteSeleccionado, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource ColorBorde}"
                              BorderThickness="0"
                              Background="White"
                              RowHeight="36"
                              ColumnHeaderHeight="38"
                              ColumnHeaderStyle="{StaticResource CabeceraGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="50"
                                                Binding="{Binding IdPaciente, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Nombre" Width="*"
                                                Binding="{Binding Nombre, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Apellidos" Width="1.3*"
                                                Binding="{Binding Apellidos, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="DNI" Width="100"
                                                Binding="{Binding Dni, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Edad" Width="60"
                                                Binding="{Binding Edad, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Teléfono" Width="105"
                                                Binding="{Binding Telefono, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulario (crear / editar) -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="{Binding TituloFormulario}"
                              FontWeight="SemiBold" FontSize="14"
                              BorderBrush="{StaticResource ColorBorde}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0" TextElement.FontWeight="Normal" TextElement.FontSize="13">

                                <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding PacienteEdicion.Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Apellidos" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding PacienteEdicion.Apellidos, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="DNI / NIE" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding PacienteEdicion.Dni, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Fecha de nacimiento" Style="{StaticResource Etiqueta}"/>
                                <DatePicker SelectedDate="{Binding PacienteEdicion.FechaNacimiento, Mode=TwoWay}"/>

                                <TextBlock Text="Género" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding Generos}"
                                          SelectedItem="{Binding PacienteEdicion.Genero, Mode=TwoWay}"/>

                                <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding PacienteEdicion.Telefono, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Email" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding PacienteEdicion.Email, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding PacienteEdicion.Direccion, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Grupo sanguíneo" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding GruposSanguineos}"
                                          SelectedItem="{Binding PacienteEdicion.GrupoSanguineo, Mode=TwoWay}"/>

                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- Botones y mensaje de estado -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Guardar" Margin="0,0,6,0"
                                    Style="{StaticResource BotonPrimario}"
                                    Command="{Binding GuardarCommand}"/>
                            <Button Grid.Column="1" Content="Cancelar" Margin="3,0"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding CancelarCommand}"/>
                            <Button Grid.Column="2" Content="Eliminar" Margin="6,0,0,0"
                                    Style="{StaticResource BotonPeligro}"
                                    Command="{Binding EliminarCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding MensajeEstado}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
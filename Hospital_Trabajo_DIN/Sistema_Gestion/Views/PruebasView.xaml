<UserControl x:Class="Sistema_Gestion.Views.PruebasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="970">

    <UserControl.Resources>
        <!-- Convierte true/false en Visible/Collapsed (para la barra de progreso) -->
        <BooleanToVisibilityConverter x:Key="BoolAVisible"/>

        <!-- Color de la clasificación según el valor (los demás estilos vienen de Estilos.xaml) -->
        <Style x:Key="CeldaClasificacion" TargetType="TextBlock" BasedOn="{StaticResource CeldaTexto}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Clasificacion}" Value="Dentro del intervalo">
                    <Setter Property="Foreground" Value="#1E8E3E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Clasificacion}" Value="Por encima del intervalo">
                    <Setter Property="Foreground" Value="#D93025"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Clasificacion}" Value="Por debajo del intervalo">
                    <Setter Property="Foreground" Value="#E37400"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- cabecera -->
            <RowDefinition Height="*"/>
            <!-- contenido -->
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Laboratorio" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Solicitud de análisis y resultados" Style="{StaticResource Subtitulo}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: nueva solicitud -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <!-- Datos de la solicitud -->
                        <GroupBox Header="Solicitud" FontWeight="SemiBold" FontSize="14"
                                  BorderBrush="{StaticResource ColorBorde}" Padding="10" Margin="0,0,0,12">
                            <StackPanel TextElement.FontWeight="Normal" TextElement.FontSize="13">

                                <TextBlock Text="Paciente" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding Pacientes}"
                                          DisplayMemberPath="NombreCompleto"
                                          SelectedItem="{Binding PacienteSeleccionado, Mode=TwoWay}"/>

                                <TextBlock Text="Médico solicitante" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding Medicos}"
                                          DisplayMemberPath="NombreCompleto"
                                          SelectedItem="{Binding MedicoSeleccionado, Mode=TwoWay}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Id de muestra" Style="{StaticResource Etiqueta}"/>
                                        <TextBox Text="{Binding IdMuestra, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tipo de muestra" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox ItemsSource="{Binding TiposMuestra}"
                                                  SelectedItem="{Binding TipoMuestra, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Muestra válida"
                                          IsChecked="{Binding MuestraValida, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Pruebas de la solicitud -->
                        <GroupBox Header="Pruebas" FontWeight="SemiBold" FontSize="14"
                                  BorderBrush="{StaticResource ColorBorde}" Padding="10" Margin="0,0,0,12">
                            <StackPanel TextElement.FontWeight="Normal" TextElement.FontSize="13">

                                <TextBlock Text="Prueba" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding PruebasDisponibles}"
                                          DisplayMemberPath="Etiqueta"
                                          SelectedItem="{Binding PruebaSeleccionada, Mode=TwoWay}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Valor medido" Style="{StaticResource Etiqueta}"/>
                                        <TextBox Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Unidad" Style="{StaticResource Etiqueta}"/>
                                        <TextBox Text="{Binding UnidadTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="+ Añadir a la solicitud" Margin="0,0,0,10"
                                        Style="{StaticResource BotonSecundario}"
                                        Command="{Binding AnadirPruebaCommand}"/>

                                <TextBlock Text="Pruebas de esta solicitud" Style="{StaticResource Etiqueta}"/>
                                <ListBox Height="110" Margin="0,0,0,8"
                                         ItemsSource="{Binding Lineas}"
                                         DisplayMemberPath="Texto"
                                         SelectedItem="{Binding LineaSeleccionada, Mode=TwoWay}"/>

                                <Button Content="Quitar seleccionada"
                                        Style="{StaticResource BotonPeligro}"
                                        Command="{Binding QuitarPruebaCommand}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Enviar -->
                        <Button Content="Enviar al laboratorio"
                                Style="{StaticResource BotonPrimario}"
                                Command="{Binding EnviarCommand}"/>

                        <Button Content="Limpiar" Margin="0,8,0,0"
                                Style="{StaticResource BotonSecundario}"
                                Command="{Binding LimpiarCommand}"/>

                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,12,0,0"
                                     Visibility="{Binding EstaEnviando, Converter={StaticResource BoolAVisible}}"/>

                        <TextBlock Text="{Binding MensajeEstado}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Columna derecha: respuesta y resultados guardados -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Respuesta del laboratorio -->
                <Border Grid.Row="0" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EstadoRespuesta}"
                                       FontWeight="SemiBold" Foreground="{StaticResource ColorPrimario}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Respuesta del laboratorio" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTexto}"/>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding ResultadosRecibidos}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource ColorBorde}"
                                  BorderThickness="0"
                                  Background="White"
                                  RowHeight="34"
                                  ColumnHeaderHeight="36"
                                  Height="170"
                                  ColumnHeaderStyle="{StaticResource CabeceraGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Width="80"
                                                    Binding="{Binding Codigo, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="Valor" Width="90"
                                                    Binding="{Binding ValorMedido, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="Unidad" Width="90"
                                                    Binding="{Binding Unidad, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="Clasificación" Width="*"
                                                    Binding="{Binding Clasificacion, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaClasificacion}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Resultados guardados en la base de datos -->
                <Border Grid.Row="2" Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Resultados guardados" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTexto}"/>
                            <TextBlock Text="Si eliges un paciente, solo se muestran sus resultados"
                                       Style="{StaticResource Subtitulo}" FontSize="12"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding HistorialVista}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource ColorBorde}"
                                  BorderThickness="0"
                                  Background="White"
                                  RowHeight="34"
                                  ColumnHeaderHeight="36"
                                  ColumnHeaderStyle="{StaticResource CabeceraGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Width="125"
                                                    Binding="{Binding FechaRealizacion, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="Paciente" Width="*"
                                                    Binding="{Binding PacienteNombre, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="Prueba" Width="110"
                                                    Binding="{Binding PruebaNombre, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="Resultado" Width="1.4*"
                                                    Binding="{Binding ResultadoDetalles, Mode=OneWay}"
                                                    ElementStyle="{StaticResource CeldaTexto}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="Sistema_Gestion.Views.CitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="970">

    <UserControl.Resources>
        <!-- Color del texto del estado según su valor (los demás estilos vienen de Estilos.xaml) -->
        <Style x:Key="CeldaEstado" TargetType="TextBlock" BasedOn="{StaticResource CeldaTexto}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Estado}" Value="Programada">
                    <Setter Property="Foreground" Value="#2F6FED"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Completada">
                    <Setter Property="Foreground" Value="#1E8E3E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="Cancelada">
                    <Setter Property="Foreground" Value="#D93025"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Estado}" Value="No asistió">
                    <Setter Property="Foreground" Value="#E37400"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- cabecera: título y buscador -->
            <RowDefinition Height="Auto"/>
            <!-- tarjetas resumen -->
            <RowDefinition Height="*"/>
            <!-- tabla y formulario -->
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">

            <!-- Buscador (a la derecha) -->
            <Border DockPanel.Dock="Right" Style="{StaticResource Tarjeta}"
                    Width="320" Padding="12,6" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Text="Buscar:" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Style="{StaticResource Subtitulo}" Margin="0,0,8,0"/>
                    <TextBox Margin="0" BorderThickness="0"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Border>

            <StackPanel>
                <TextBlock Text="Citas" Style="{StaticResource Titulo}"/>
                <TextBlock Text="Gestión de citas médicas" Style="{StaticResource Subtitulo}"/>
            </StackPanel>
        </DockPanel>

        <!-- Tarjetas resumen -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">

            <Border Style="{StaticResource Tarjeta}" MinWidth="200" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalCitas}" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource ColorPrimario}"/>
                    <TextBlock Text="Citas registradas" Style="{StaticResource Subtitulo}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" MinWidth="200" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="{Binding CitasHoy}" FontSize="32" FontWeight="Bold" Foreground="#1E8E3E"/>
                    <TextBlock Text="Citas hoy" Style="{StaticResource Subtitulo}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" MinWidth="200">
                <StackPanel>
                    <TextBlock Text="{Binding CitasProgramadas}" FontSize="32" FontWeight="Bold" Foreground="#E37400"/>
                    <TextBlock Text="Programadas" Style="{StaticResource Subtitulo}"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Tabla + formulario -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Tabla de citas -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="+ Nueva Cita" Width="130"
                                Style="{StaticResource BotonPrimario}"
                                Command="{Binding NuevoCommand}"/>
                        <CheckBox DockPanel.Dock="Right" Content="Solo programadas"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  IsChecked="{Binding SoloProgramadas, Mode=TwoWay}"/>
                        <TextBlock Text="Listado de citas" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- SelectedItem TwoWay: al elegir una fila, el ViewModel carga el formulario -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CitasVista}"
                              SelectedItem="{Binding CitaSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource ColorBorde}"
                              BorderThickness="0"
                              Background="White"
                              RowHeight="36"
                              ColumnHeaderHeight="38"
                              ColumnHeaderStyle="{StaticResource CabeceraGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="45"
                                                Binding="{Binding IdCita, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Fecha y hora" Width="125"
                                                Binding="{Binding FechaHora, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Paciente" Width="*"
                                                Binding="{Binding PacienteNombre, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Médico" Width="*"
                                                Binding="{Binding MedicoNombre, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Motivo" Width="1.2*"
                                                Binding="{Binding Motivo, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="Estado" Width="95"
                                                Binding="{Binding Estado, Mode=OneWay}"
                                                ElementStyle="{StaticResource CeldaEstado}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulario (crear / editar) -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="{Binding TituloFormulario}"
                              FontWeight="SemiBold" FontSize="14"
                              BorderBrush="{StaticResource ColorBorde}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0" TextElement.FontWeight="Normal" TextElement.FontSize="13">

                                <TextBlock Text="Paciente" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding Pacientes}"
                                          DisplayMemberPath="NombreCompleto"
                                          SelectedValuePath="IdPaciente"
                                          SelectedValue="{Binding CitaEdicion.IdPaciente, Mode=TwoWay}"/>

                                <TextBlock Text="Médico" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding Medicos}"
                                          DisplayMemberPath="NombreCompleto"
                                          SelectedValuePath="IdMedico"
                                          SelectedValue="{Binding CitaEdicion.IdMedico, Mode=TwoWay}"/>

                                <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                                <DatePicker SelectedDate="{Binding FechaSeleccionada, Mode=TwoWay}"/>

                                <TextBlock Text="Hora (HH:mm)" Style="{StaticResource Etiqueta}"/>
                                <TextBox Text="{Binding HoraTexto, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Motivo" Style="{StaticResource Etiqueta}"/>
                                <TextBox Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" Padding="6,4"
                                         Text="{Binding CitaEdicion.Motivo, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Estado" Style="{StaticResource Etiqueta}"/>
                                <ComboBox ItemsSource="{Binding Estados}"
                                          SelectedItem="{Binding CitaEdicion.Estado, Mode=TwoWay}"/>

                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- Botones y mensaje de estado -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Guardar" Margin="0,0,6,0"
                                    Style="{StaticResource BotonPrimario}"
                                    Command="{Binding GuardarCommand}"/>
                            <Button Grid.Column="1" Content="Cancelar" Margin="3,0"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding CancelarCommand}"/>
                            <Button Grid.Column="2" Content="Eliminar" Margin="6,0,0,0"
                                    Style="{StaticResource BotonPeligro}"
                                    Command="{Binding EliminarCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding MensajeEstado}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTexto}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
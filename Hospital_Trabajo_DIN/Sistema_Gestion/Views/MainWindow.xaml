<Window x:Class="Sistema_Gestion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Sistema_Gestion.ViewModels"
        xmlns:views="clr-namespace:Sistema_Gestion.Views"
        mc:Ignorable="d"
        Title="Hospital - Sistema de Gestión"
        Height="720" Width="1200" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Cada ViewModel se dibuja con su View -->
        <DataTemplate DataType="{x:Type vm:PacientesViewModel}">
            <views:PacientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CitasViewModel}">
            <views:CitasView/>
        </DataTemplate>

        <!-- Estilo de los botones del menú lateral -->
        <Style x:Key="BotonMenu" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="14,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2A5C96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <!-- menú lateral: ancho fijo -->
            <ColumnDefinition Width="*"/>
            <!-- contenido: ocupa el resto -->
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <DockPanel Grid.Column="0" Background="#173B67" LastChildFill="True">

            <!-- Pie del menú (abajo) -->
            <StackPanel DockPanel.Dock="Bottom" Margin="20,0,0,18">
                <TextBlock Text="Sistema de Gestión" Foreground="#9FB6D6" FontSize="12"/>
                <TextBlock Text="v1.0.0" Foreground="#9FB6D6" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Logo y botones (arriba) -->
            <StackPanel>
                <Image Source="/imagenes/logo.png"
                       Width="110" Height="110"
                       Margin="0,25,0,10"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="Hospital"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- El botón de la sección activa se resalta con un DataTrigger -->
                <Button Content="Pacientes" Command="{Binding MostrarPacientesCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonMenu}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionActual}" Value="Pacientes">
                                    <Setter Property="Background" Value="#2F6FED"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Citas" Command="{Binding MostrarCitasCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonMenu}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeccionActual}" Value="Citas">
                                    <Setter Property="Background" Value="#2F6FED"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Salir"
                        Style="{StaticResource BotonMenu}"
                        Command="{Binding SalirCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Zona de contenido -->
        <Grid Grid.Column="1" Background="#F3F6FA">
            <ContentControl Content="{Binding VistaActual}"/>
        </Grid>
    </Grid>
</Window>